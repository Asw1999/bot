<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CoC Bot"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF6D28"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#16213E"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Service Status"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accessibility: ❌ OFF"
                    android:textColor="#F44336"
                    android:textSize="14sp"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/tvCaptureStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Screen Capture: ❌ OFF"
                    android:textColor="#F44336"
                    android:textSize="14sp"
                    android:paddingTop="4dp" />

                <Button
                    android:id="@+id/btnOpenAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Accessibility"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnStartCapture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Screen Capture"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Target Config -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#16213E"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Target Loot"
                    android:textColor="#FF6D28"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Target Gold"
                    app:boxStrokeColor="#FF6D28">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTargetGold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="200000"
                        android:textColor="#FFFFFF" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Target Elixir"
                    android:layout_marginTop="8dp"
                    app:boxStrokeColor="#FF6D28">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTargetElixir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="200000"
                        android:textColor="#FFFFFF" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Target Dark Elixir"
                    android:layout_marginTop="8dp"
                    app:boxStrokeColor="#FF6D28">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTargetDark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="0"
                        android:textColor="#FFFFFF" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Deploy Config -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#16213E"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deploy Settings"
                    android:textColor="#FF6D28"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deploy Side"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spDeploySide"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#FF6D28" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deploy Pattern"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <Spinner
                    android:id="@+id/spDeployPattern"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#FF6D28" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Max Attacks (0=unlimited)"
                    android:layout_marginTop="8dp"
                    app:boxStrokeColor="#FF6D28">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMaxAttacks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="50"
                        android:textColor="#FFFFFF" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Launch Button -->
        <Button
            android:id="@+id/btnLaunchOverlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="LAUNCH BOT OVERLAY"
            android:textSize="16sp"
            android:backgroundTint="#FF6D28"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="SAVE CONFIG"
            android:textSize="14sp"
            android:backgroundTint="#4CAF50"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>